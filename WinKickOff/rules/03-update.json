{
  "comment": ["Windows Update. Section 2 of the v0.2 machine script. Order: blocks are removed before the settings."],
  "rules": [
    {
      "id": "update.unblock",
      "group": "update",
      "phase": "specialize",
      "title": "Remove all Windows Update blocks",
      "level": "baseline",
      "default": true,
      "tags": ["windows update", "wuauserv", "updates", "store"],
      "doc": "docs/technical/reference/06-windows-update.md",
      "summary": "Removes policies that turn off updates, driver updates or Store automatic updates, and returns disabled update services to manual startup.",
      "effect": "Changes nothing on a clean image; removes leftovers of third-party \"optimizers\" and makes it safe to run the script again.",
      "versions": "No changes.",
      "verify": "Get-ItemProperty HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
      "actions": [
        {
          "type": "reg-remove",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
          "name": "NoAutoUpdate"
        },
        {
          "type": "reg-remove",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "name": "DoNotConnectToWindowsUpdateInternetLocations"
        },
        {
          "type": "reg-remove",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "name": "DisableWindowsUpdateAccess"
        },
        {
          "type": "reg-remove",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "name": "ExcludeWUDriversInQualityUpdate"
        },
        {"type": "reg-remove", "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsStore", "name": "AutoDownload"},
        {
          "type": "ps",
          "script": [
            "foreach ($svc in 'wuauserv','UsoSvc','BITS','DoSvc','WaaSMedicSvc') {",
            "    $key = \"HKLM:\\SYSTEM\\CurrentControlSet\\Services\\$svc\"",
            "    if (Test-Path $key) {",
            "        $cur = (Get-ItemProperty $key -Name Start -ErrorAction SilentlyContinue).Start",
            "        if ($cur -eq 4) { Set-Reg -Path $key -Name 'Start' -Type DWord -Value 3 -Why 're-enable update service' }",
            "    }",
            "}"
          ]
        }
      ]
    },
    {
      "id": "update.automatic",
      "group": "update",
      "phase": "specialize",
      "title": "Automatic update installation and active hours",
      "level": "recommended",
      "default": true,
      "requires": ["update.unblock"],
      "tags": ["windows update", "auoptions", "active hours", "restart"],
      "doc": "docs/technical/reference/06-windows-update.md#windowsupdateautomatic",
      "summary": "Updates are downloaded and installed automatically; automatic restarts are not allowed during active hours.",
      "effect": "Restarts happen at night or before the workday starts; the user sees a notification and can postpone within the policy limits.",
      "risk": "Active hours cannot exceed 18 hours. PCs that run around the clock will restart outside active hours.",
      "versions": "Works on Windows 10 and 11; in 24H2 fixed hours replace automatic detection of active hours.",
      "verify": "Get-ItemProperty HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
      "rollback": "Delete SetActiveHours, ActiveHoursStart, ActiveHoursEnd.",
      "params": {
        "start": {"type": "int", "title": "Active hours start (hour)", "default": 8, "min": 0, "max": 23},
        "end": {"type": "int", "title": "Active hours end (hour)", "default": 20, "min": 0, "max": 23}
      },
      "actions": [
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
          "name": "NoAutoUpdate",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
          "name": "AUOptions",
          "kind": "DWord",
          "value": 4,
          "why": "auto download and install"
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "name": "SetActiveHours",
          "kind": "DWord",
          "value": 1
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "name": "ActiveHoursStart",
          "kind": "DWord",
          "value": "{start}"
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "name": "ActiveHoursEnd",
          "kind": "DWord",
          "value": "{end}"
        }
      ]
    },
    {
      "id": "update.other-microsoft-products",
      "group": "update",
      "phase": "specialize",
      "title": "Updates for other Microsoft products (Office, .NET)",
      "level": "recommended",
      "default": false,
      "requires": ["update.unblock"],
      "tags": ["microsoft update", "office", ".net"],
      "doc": "docs/technical/reference/06-windows-update.md#updateothermicrosoftproducts",
      "summary": "Opts in to Microsoft Update: fixes for Office (MSI), .NET and other products arrive together with Windows updates.",
      "effect": "The toggle in Settings is turned on and locked. Office 365 (Click-to-Run) updates independently through its own mechanism.",
      "versions": "No changes.",
      "verify": "(New-Object -ComObject Microsoft.Update.ServiceManager).Services | Where-Object IsDefaultAUService",
      "actions": [
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
          "name": "AllowMUUpdateService",
          "kind": "DWord",
          "value": 1,
          "why": "Office and other Microsoft products via WU"
        }
      ]
    },
    {
      "id": "update.defer-feature",
      "group": "update",
      "phase": "specialize",
      "title": "Defer feature updates",
      "level": "optional",
      "default": true,
      "requires": ["update.unblock"],
      "tags": ["feature updates", "24h2", "25h2", "deferral", "defer"],
      "doc": "docs/technical/reference/06-windows-update.md#deferfeatureupdatesdays",
      "summary": "Annual version updates arrive with a delay; monthly security updates are not deferred.",
      "effect": "During the deferral period, Microsoft fixes the bugs of the first weeks and accounting software vendors release compatible versions.",
      "risk": "Requires working compatibility assessment: the minimal telemetry rule intentionally leaves DiagTrack on manual startup instead of disabling it.",
      "versions": "Windows 10 1703+ and Windows 11 Pro/Enterprise; Home has no deferral. Range 0-365 days.",
      "verify": "Get-ItemProperty HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate | Select-Object DeferFeatureUpdatesPeriodInDays",
      "rollback": "Delete DeferFeatureUpdates and DeferFeatureUpdatesPeriodInDays.",
      "params": {"days": {"type": "int", "title": "Deferral period, days", "default": 90, "min": 1, "max": 365}},
      "actions": [
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "name": "DeferFeatureUpdates",
          "kind": "DWord",
          "value": 1
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
          "name": "DeferFeatureUpdatesPeriodInDays",
          "kind": "DWord",
          "value": "{days}",
          "why": "security updates are never deferred"
        }
      ]
    },
    {
      "id": "update.delivery-optimization-lan",
      "group": "update",
      "phase": "specialize",
      "title": "Delivery Optimization: share updates only on the local network",
      "level": "recommended",
      "default": true,
      "tags": ["delivery optimization", "traffic", "peer", "lan"],
      "doc": "docs/technical/reference/06-windows-update.md#deliveryoptimizationlanonly",
      "summary": "PCs on the same network share downloaded update fragments with each other; nothing is uploaded outside the network.",
      "effect": "In an office with a dozen PCs, an update is downloaded from the internet only once. Port 7680 must be open between PCs (Windows creates the firewall rule itself).",
      "versions": "Modes 0 (HTTP only), 1 (local network), 3 (internet) and 99 (simple mode) have been the same since Windows 10 1607.",
      "verify": "Get-DOConfig",
      "params": {
        "mode": {
          "type": "enum",
          "title": "Mode",
          "default": 1,
          "values": [
            {"value": 1, "title": "Local network only"},
            {"value": 0, "title": "HTTP only, no peer sharing"},
            {"value": 99, "title": "Simple mode without the cloud"}
          ]
        }
      },
      "actions": [
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization",
          "name": "DODownloadMode",
          "kind": "DWord",
          "value": "{mode}",
          "why": "LAN peers only"
        }
      ]
    }
  ]
}
