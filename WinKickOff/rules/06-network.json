{
  "comment": ["SMB, name resolution, firewall. Section 5 of the v0.2 machine script."],
  "rules": [
    {
      "id": "network.smb1-off",
      "group": "network",
      "phase": "specialize",
      "title": "SMB1 disabled and removed",
      "level": "recommended",
      "default": true,
      "tags": ["smb1", "smbv1", "wannacry", "mfp", "nas", "scan to folder"],
      "doc": "docs/technical/reference/09-network-smb-firewall.md#disablesmb1",
      "summary": "The server does not respond over SMB1, the client driver is disabled, and the SMB1Protocol feature is removed if it is installed.",
      "effect": "The 1996 protocol through which WannaCry and NotPetya spread is completely absent.",
      "risk": "SMB1-only devices (multifunction printers with scan to network folder made before 2015, old NAS devices, Windows XP) will not connect. Solution: firmware with SMB2/3, scanning to FTP or e-mail.",
      "versions": "Windows 11 24H2 does not contain SMB1 at all (a WARN about the driver in the log is expected); on Windows 10 1709+ and Windows 11 up to 23H2 the feature is not installed but available; on Windows 10 before 1709 it is installed.",
      "verify": "Get-SmbServerConfiguration | Select-Object EnableSMB1Protocol",
      "rollback": "Not recommended; Enable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol on builds where it exists.",
      "actions": [
        {
          "type": "reg",
          "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
          "name": "SMB1",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {"type": "service", "name": "mrxsmb10", "start": 4, "default": "unknown"},
        {"type": "feature", "name": "SMB1Protocol", "state": "Disabled", "default": "Disabled"}
      ]
    },
    {
      "id": "network.smb-signing",
      "group": "network",
      "phase": "specialize",
      "title": "SMB signing required (server and client)",
      "level": "recommended",
      "default": true,
      "tags": ["smb", "signing", "ntlm relay", "mfp", "nas"],
      "doc": "docs/technical/reference/09-network-smb-firewall.md#requiresmbsigning",
      "summary": "Every SMB packet is signed; NTLM relay and tampering with shared folder traffic are impossible.",
      "effect": "Workgroup PCs configured with this file are compatible with each other; performance on gigabit networks drops by a few percent.",
      "risk": "Old NAS devices and multifunction printers without SMB2 signing support will not connect. Relax it together with the SMB1 and NTLMv2 rules after an inventory.",
      "versions": "Windows 11 24H2 and Server 2025 require signing by default on Pro and Enterprise; the rule sets it explicitly, also for Windows 10 and Windows 11 up to 23H2.",
      "verify": "Get-SmbServerConfiguration | Select-Object RequireSecuritySignature; Get-SmbClientConfiguration | Select-Object RequireSecuritySignature",
      "rollback": "Set-SmbServerConfiguration -RequireSecuritySignature $false; Set-SmbClientConfiguration -RequireSecuritySignature $false",
      "actions": [
        {
          "type": "reg",
          "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
          "name": "RequireSecuritySignature",
          "kind": "DWord",
          "value": 1,
          "default": "unknown"
        },
        {
          "type": "reg",
          "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters",
          "name": "EnableSecuritySignature",
          "kind": "DWord",
          "value": 1,
          "default": "unknown"
        },
        {
          "type": "reg",
          "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters",
          "name": "RequireSecuritySignature",
          "kind": "DWord",
          "value": 1,
          "default": "unknown"
        },
        {
          "type": "reg",
          "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters",
          "name": "EnableSecuritySignature",
          "kind": "DWord",
          "value": 1,
          "default": "unknown"
        }
      ]
    },
    {
      "id": "network.llmnr-off",
      "group": "network",
      "phase": "specialize",
      "title": "LLMNR disabled (protection against name spoofing on the network)",
      "level": "recommended",
      "default": true,
      "tags": ["llmnr", "responder", "name spoofing", "multicast", "name resolution"],
      "doc": "docs/technical/reference/09-network-smb-firewall.md#disablellmnr",
      "summary": "LLMNR multicast name queries are disabled; Responder-type tools do not get hashes from these PCs.",
      "effect": "Workgroup computer names continue to resolve through NetBIOS (left enabled) and mDNS.",
      "versions": "Policy available since Windows Vista; in 24H2 Microsoft announced LLMNR as deprecated in favor of mDNS.",
      "verify": "Get-ItemProperty 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\DNSClient' -Name EnableMulticast",
      "rollback": "Delete the value.",
      "actions": [
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\DNSClient",
          "name": "EnableMulticast",
          "kind": "DWord",
          "value": 0,
          "why": "LLMNR off"
        }
      ]
    },
    {
      "id": "network.netbios-off",
      "group": "network",
      "phase": "specialize",
      "title": "NetBIOS over TCP/IP disabled",
      "level": "risky",
      "default": false,
      "tags": ["netbios", "nbt-ns", "responder", "137", "139", "name resolution"],
      "doc": "docs/technical/reference/09-network-smb-firewall.md#disablenetbios",
      "summary": "Closes the second name spoofing channel (NBT-NS) and ports 137-139 on all current interfaces.",
      "effect": "Without a domain and WINS, a name such as \\\\PC-NAME resolves only through mDNS (pc-name.local) or the router's DNS; familiar shortcuts to shared folders may stop working.",
      "risk": "Interfaces added after installation (a new Wi-Fi adapter, VPN) get the default setting. Enable it only after testing on the specific network.",
      "versions": "The values have been the same since Windows 2000; in 24H2 NetBIOS is enabled by default.",
      "verify": "Get-CimInstance Win32_NetworkAdapterConfiguration | Select-Object Description, TcpipNetbiosOptions",
      "rollback": "NetbiosOptions = 0 for the interfaces, delete NodeType.",
      "actions": [
        {
          "type": "reg",
          "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\NetBT\\Parameters",
          "name": "NodeType",
          "kind": "DWord",
          "value": 2,
          "why": "P-node: no NBT broadcasts",
          "default": "absent"
        },
        {
          "type": "ps",
          "script": [
            "Get-ChildItem 'HKLM:\\SYSTEM\\CurrentControlSet\\Services\\NetBT\\Parameters\\Interfaces' -ErrorAction SilentlyContinue | ForEach-Object {",
            "    Set-Reg -Path $_.PSPath -Name 'NetbiosOptions' -Type DWord -Value 2 -Why 'NetBIOS over TCP/IP off'",
            "}"
          ]
        }
      ]
    },
    {
      "id": "network.firewall",
      "group": "network",
      "phase": "specialize",
      "title": "Firewall on for all profiles, inbound blocked, dropped packets logged",
      "level": "recommended",
      "default": true,
      "tags": ["firewall", "inbound", "logging", "pfirewall.log"],
      "doc": "docs/technical/reference/09-network-smb-firewall.md#firewallonwithlogging",
      "summary": "Policy for the domain, private and public profiles: the firewall is on and cannot be turned off from Control Panel, inbound connections are blocked by default, outbound connections are allowed, dropped packets are written to a 16 MB file.",
      "effect": "Allow rules (file and printer sharing, Delivery Optimization, mDNS) keep working; during an investigation you can see who tried to connect to which ports.",
      "risk": "The network profile (private/public) is not set by the file; folder sharing requires the private profile.",
      "versions": "The policy has been the same since Windows Vista.",
      "verify": "Get-NetFirewallProfile | Select-Object Name, Enabled, DefaultInboundAction, LogBlocked",
      "rollback": "Delete the profile keys under HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall.",
      "actions": [
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile",
          "name": "EnableFirewall",
          "kind": "DWord",
          "value": 1
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile",
          "name": "DefaultInboundAction",
          "kind": "DWord",
          "value": 1,
          "why": "block inbound by default"
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile",
          "name": "DefaultOutboundAction",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile\\Logging",
          "name": "LogDroppedPackets",
          "kind": "DWord",
          "value": 1
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile\\Logging",
          "name": "LogFileSize",
          "kind": "DWord",
          "value": 16384
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\DomainProfile\\Logging",
          "name": "LogFilePath",
          "kind": "String",
          "value": "%systemroot%\\system32\\LogFiles\\Firewall\\pfirewall.log"
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PrivateProfile",
          "name": "EnableFirewall",
          "kind": "DWord",
          "value": 1
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PrivateProfile",
          "name": "DefaultInboundAction",
          "kind": "DWord",
          "value": 1,
          "why": "block inbound by default"
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PrivateProfile",
          "name": "DefaultOutboundAction",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PrivateProfile\\Logging",
          "name": "LogDroppedPackets",
          "kind": "DWord",
          "value": 1
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PrivateProfile\\Logging",
          "name": "LogFileSize",
          "kind": "DWord",
          "value": 16384
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PrivateProfile\\Logging",
          "name": "LogFilePath",
          "kind": "String",
          "value": "%systemroot%\\system32\\LogFiles\\Firewall\\pfirewall.log"
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PublicProfile",
          "name": "EnableFirewall",
          "kind": "DWord",
          "value": 1
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PublicProfile",
          "name": "DefaultInboundAction",
          "kind": "DWord",
          "value": 1,
          "why": "block inbound by default"
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PublicProfile",
          "name": "DefaultOutboundAction",
          "kind": "DWord",
          "value": 0
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PublicProfile\\Logging",
          "name": "LogDroppedPackets",
          "kind": "DWord",
          "value": 1
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PublicProfile\\Logging",
          "name": "LogFileSize",
          "kind": "DWord",
          "value": 16384
        },
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\WindowsFirewall\\PublicProfile\\Logging",
          "name": "LogFilePath",
          "kind": "String",
          "value": "%systemroot%\\system32\\LogFiles\\Firewall\\pfirewall.log"
        }
      ]
    }
  ]
}
