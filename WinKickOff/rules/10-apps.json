    {
      "id": "apps.remove.onedrive",
      "group": "apps.remove",
      "phase": "default-user",
      "title": "OneDrive",
      "level": "optional",
      "default": true,
      "tags": ["onedrive", "cloud", "sync", "onedrivesetup", "run"],
      "doc": "docs/technical/reference/13-services-apps.md#onedrive",
      "summary": "OneDrive is not installed for users: the autostart of its installer is removed from the default profile.",
      "effect": "Accounts created after installation (Admin, User and later ones) get a profile without OneDrive: no icon, no OneDrive folder, no file sync with the cloud. Users who have already signed in keep their OneDrive.",
      "risk": "User files are not copied to the Microsoft cloud; the organisation sets up backups separately.",
      "versions": "Windows 10 and 11. The installer OneDriveSetup.exe (in System32 on Windows 11 24H2+) stays in the system and runs only when started by hand.",
      "verify": "After the first sign-in of a new user: no %LOCALAPPDATA%\\Microsoft\\OneDrive folder and no OneDrive value in HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run.",
      "rollback": "For a user: run %SystemRoot%\\System32\\OneDriveSetup.exe or install OneDrive from the Microsoft website.",
      "actions": [
        {
          "type": "reg-remove",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
          "name": "OneDriveSetup",
          "default": "unknown"
        }
      ]
    },
    {
      "id": "onedrive.kfm-block",
      "group": "apps.onedrive",
      "phase": "specialize",
      "title": "OneDrive: block moving user folders to the cloud",
      "level": "optional",
      "default": true,
      "tags": ["onedrive", "known folders", "kfm", "cloud"],
      "doc": "docs/technical/reference/19-more-privacy.md#onedrive-policies",
      "summary": "Users cannot move \"Desktop\", \"Documents\" and \"Pictures\" to OneDrive (neither work nor personal), and folder backup in the OneDrive settings is unavailable.",
      "effect": "Work files stay on the computer and do not end up in the employee's personal cloud. On domain-joined PCs Microsoft itself blocks moving to a personal OneDrive; in a workgroup this policy is needed.",
      "versions": "OneDrive sync client (all supported versions). The HKCU value from the customer's list is not documented by Microsoft and is not written.",
      "verify": "reg query \"HKLM\\SOFTWARE\\Policies\\Microsoft\\OneDrive\" /v KFMBlockOptIn",
      "rollback": "Delete the value.",
      "note": "28.09.2026, customer list MoreOptions: OneDrive policies (card 19, section \"OneDrive policies\")",
      "actions": [
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\OneDrive",
          "name": "KFMBlockOptIn",
          "kind": "DWord",
          "value": 1
        }
      ]
    },
    {
      "id": "onedrive.no-traffic-before-signin",
      "group": "apps.onedrive",
      "phase": "specialize",
      "title": "OneDrive: no network access before the user signs in",
      "level": "optional",
      "default": true,
      "tags": ["onedrive", "network", "telemetry"],
