{
  "comment": [
    "Services and app removal. Section 9 of the v0.2 machine script.",
    "One rule per app: the generator collects every enabled appx action into one Remove-Apps call."
  ],
  "rules": [
    {
      "id": "apps.retail-demo-off",
      "group": "apps",
      "phase": "specialize",
      "title": "Retail demo service disabled",
      "level": "baseline",
      "default": true,
      "tags": ["retaildemo", "service"],
      "doc": "docs/technical/reference/13-services-apps.md",
      "summary": "The RetailDemo service is needed only on store display PCs.",
      "effect": "One background service fewer.",
      "actions": [{"type": "service", "name": "RetailDemo", "start": 4, "default": 3}]
    },
    {
      "id": "apps.xbox-services-off",
      "group": "apps",
      "phase": "specialize",
      "title": "Xbox services disabled, game recording (Game DVR) off",
      "level": "recommended",
      "default": true,
      "tags": ["xbox", "game bar", "gamedvr", "services"],
      "doc": "docs/technical/reference/13-services-apps.md#removexboxservices",
      "summary": "Xbox Live services (authentication, game saves, networking, controllers) are disabled; a policy prohibits game recording and Game Bar.",
      "effect": "No Xbox background services and no background screen recording that slows down low-end PCs. Store games that use Xbox Live do not work.",
      "versions": "XboxGipSvc since Windows 10 1709.",
      "verify": "Get-Service Xbl*, XboxNetApiSvc, XboxGipSvc | Select-Object Name, StartType",
      "rollback": "Set-Service <name> -StartupType Manual; delete AllowGameDVR.",
      "actions": [
        {"type": "service", "name": "XblAuthManager", "start": 4, "default": 3},
        {"type": "service", "name": "XblGameSave", "start": 4, "default": 3},
        {"type": "service", "name": "XboxNetApiSvc", "start": 4, "default": 3},
        {"type": "service", "name": "XboxGipSvc", "start": 4, "default": 3},
        {
          "type": "reg",
          "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\GameDVR",
          "name": "AllowGameDVR",
          "kind": "DWord",
          "value": 0
        }
      ]
    },
    {
      "id": "apps.maps-broker-off",
      "group": "apps",
      "phase": "specialize",
      "title": "Offline maps download service disabled",
      "level": "optional",
      "default": true,
      "requires": ["apps.remove.maps"],
      "tags": ["mapsbroker", "maps", "service"],
      "doc": "docs/technical/reference/13-services-apps.md#removexboxservices",
      "summary": "MapsBroker serves the Maps app; without the app the service is not needed. In the v0.2 file it was disabled under the Xbox condition; here it is tied to removing Maps.",
      "effect": "One automatic service fewer.",
      "rollback": "Set-Service MapsBroker -StartupType Automatic",
      "actions": [{"type": "service", "name": "MapsBroker", "start": 4, "default": 2}]
    },
    {
      "id": "apps.remove-quick-assist",
      "group": "apps",
      "phase": "specialize",
      "title": "Remove Quick Assist",
      "level": "recommended",
      "default": true,
      "tags": ["quick assist", "scammers", "remote access", "capability"],
      "doc": "docs/technical/reference/13-services-apps.md#removequickassist",
      "summary": "The built-in remote control tool that \"tech support\" scammers ask people to launch over the phone is removed (the Windows 10 feature and the Windows 11 Store version).",
      "effect": "The organization chooses its own tool for support by its administrator. The user can reinstall Quick Assist from the Store.",
      "versions": "The App.Support.QuickAssist feature in Windows 10 1809+ and 11 21H2; a Store app since 22H2.",
      "verify": "Get-WindowsCapability -Online -Name 'App.Support.QuickAssist*' ",
      "rollback": "Store -> Quick Assist, or Add-WindowsCapability -Online -Name App.Support.QuickAssist~~~~0.0.1.0",
      "actions": [
        {"type": "capability", "pattern": "App.Support.QuickAssist*"},
        {"type": "appx", "names": ["MicrosoftCorporationII.QuickAssist"]}
      ]
    },
    {
      "id": "apps.remove.bing-search",
      "group": "apps.remove",
      "phase": "specialize",
      "title": "Bing Search (for the Start menu)",
      "level": "optional",
      "default": true,
      "tags": ["appx", "bing", "start menu"],
      "doc": "docs/technical/reference/13-services-apps.md#table-of-removed-apps",
      "summary": "Sends Start menu queries to Bing and shows ads.",
      "effect": "Present in the 24H2 image and later.",
      "note": "removable apps",
      "actions": [{"type": "appx", "names": ["Microsoft.BingSearch"]}]
