{
  "comment": [
    "Default user profile (hive C:\\Users\\Default\\NTUSER.DAT, mounted as $du).",
    "Section 10 of the v0.2 machine script. The generator replaces DU:\\ paths with \"$du\\\".",
    "These are personal settings of the user, not policies: the user can change them in Settings."
  ],
  "rules": [
    {
      "id": "default-user.show-file-extensions",
      "group": "default-user",
      "phase": "default-user",
      "title": "Show file name extensions",
      "level": "baseline",
      "default": true,
      "tags": ["extensions", "hidefileext", "file explorer", "phishing"],
      "doc": "docs/technical/reference/14-default-user-profile.md",
      "summary": "File name extensions are visible: \"invoice.pdf.exe\" cannot pass itself off as a PDF.",
      "effect": "The most important security setting in this section; by default Windows hides extensions.",
      "versions": "All versions.",
      "verify": "Get-ItemProperty HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced -Name HideFileExt",
      "rollback": "File Explorer Options -> View.",
      "actions": [
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "HideFileExt",
          "kind": "DWord",
          "value": 0,
          "why": "show extensions",
          "default": "absent"
        }
      ]
    },
    {
      "id": "default-user.no-sync-provider-ads",
      "group": "privacy.ads",
      "phase": "default-user",
      "title": "No OneDrive and Microsoft 365 ads in File Explorer",
      "level": "baseline",
      "default": true,
      "tags": ["file explorer", "onedrive", "ads"],
      "doc": "docs/technical/reference/14-default-user-profile.md",
      "summary": "Sync provider notifications in File Explorer are turned off.",
      "effect": "File Explorer does not show OneDrive and subscription banners.",
      "versions": "Windows 10 1607+.",
      "actions": [
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "ShowSyncProviderNotifications",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        }
      ]
    },
    {
      "id": "default-user.no-consumer-content",
      "group": "privacy.ads",
      "phase": "default-user",
      "title": "No preinstalled apps, ads, tips or \"Let's finish setting up\" screen",
      "level": "recommended",
      "default": true,
      "requires": ["privacy.consumer-content"],
      "tags": [
        "contentdeliverymanager",
        "preinstalled apps",
        "ads",
        "spotlight",
        "scoobe",
        "start menu",
        "advertising id"
      ],
      "doc": "docs/technical/reference/14-default-user-profile.md#values-under-the-disableconsumercontent-condition",
      "summary": "17 ContentDeliveryManager values (the Store does not install apps silently, no tips or \"fun facts\"), no \"Let's finish setting up your device\" screen, no recommendations or Microsoft account reminders in Start, advertising ID and tailored experiences turned off.",
      "effect": "These values do on Pro what the DisableWindowsConsumerFeatures policy does on Enterprise.",
      "versions": "Start_IrisRecommendations since Windows 11 22H2; Start_AccountNotifications since 23H2; the rest since Windows 10.",
      "rollback": "Settings -> Personalization and Privacy, or the same values in the Default hive.",
      "actions": [
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "ContentDeliveryAllowed",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "FeatureManagementEnabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "OemPreInstalledAppsEnabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "PreInstalledAppsEnabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "PreInstalledAppsEverEnabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SilentInstalledAppsEnabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SoftLandingEnabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SystemPaneSuggestionsEnabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "RotatingLockScreenOverlayEnabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-310093Enabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-338387Enabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-338388Enabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-338389Enabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-338393Enabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-353694Enabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-353696Enabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
          "name": "SubscribedContent-353698Enabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\UserProfileEngagement",
          "name": "ScoobeSystemSettingEnabled",
          "kind": "DWord",
          "value": 0,
          "why": "no \"finish setting up your device\"",
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "Start_IrisRecommendations",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "Start_AccountNotifications",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo",
          "name": "Enabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Privacy",
          "name": "TailoredExperiencesWithDiagnosticDataEnabled",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        }
      ]
    },
    {
      "id": "default-user.widgets-button-off",
      "group": "default-user",
      "phase": "default-user",
      "title": "Widgets button hidden",
      "level": "recommended",
      "default": true,
      "requires": ["privacy.widgets-off"],
      "tags": ["widgets", "taskbarda", "taskbar"],
      "doc": "docs/technical/reference/14-default-user-profile.md#values-under-other-conditions",
      "summary": "The widgets button on the taskbar is hidden for every new user (duplicates the Dsh policy).",
      "effect": "A taskbar without the weather and news button.",
      "versions": "Windows 11.",
      "actions": [
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "TaskbarDa",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        }
      ]
    },
    {
      "id": "default-user.copilot-off",
      "group": "privacy.ai",
      "phase": "default-user",
      "title": "Copilot turned off in the user profile",
      "level": "recommended",
      "default": true,
      "requires": ["privacy.copilot-recall-off"],
      "tags": ["copilot", "taskbar", "user policy"],
      "doc": "docs/technical/reference/14-default-user-profile.md#values-under-other-conditions",
      "summary": "The Copilot button is hidden; the TurnOffWindowsCopilot user policy is written to the profile (the only level where it applies).",
      "effect": "Copilot Preview (23H2) does not appear; in 24H2 the app is removed by a separate rule.",
      "versions": "ShowCopilotButton and the policy since Windows 11 23H2.",
      "actions": [
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "name": "ShowCopilotButton",
          "kind": "DWord",
          "value": 0,
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Software\\Policies\\Microsoft\\Windows\\WindowsCopilot",
          "name": "TurnOffWindowsCopilot",
          "kind": "DWord",
          "value": 1,
          "why": "user-scope policy"
        }
      ]
    },
    {
      "id": "default-user.autoplay-off",
      "group": "default-user",
      "phase": "default-user",
      "title": "No AutoPlay dialog for media",
      "level": "recommended",
      "default": true,
      "requires": ["removable.autorun-off"],
      "tags": ["autoplay", "storage media"],
      "doc": "docs/technical/reference/14-default-user-profile.md#values-under-other-conditions",
      "summary": "The \"What do you want to do with this media?\" dialog is turned off for every new user.",
      "effect": "Complements the machine-level AutoRun policy.",
      "versions": "All versions.",
      "actions": [
        {
          "type": "reg",
          "path": "DU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\AutoplayHandlers",
          "name": "DisableAutoplay",
          "kind": "DWord",
          "value": 1,
          "default": "absent"
        }
      ]
    },
    {
      "id": "default-user.region",
      "group": "default-user",
      "phase": "default-user",
      "title": "User region",
      "level": "baseline",
      "default": true,
      "tags": ["region", "geo", "ukraine", "store"],
      "doc": "docs/technical/reference/14-default-user-profile.md#unconditional-values",
      "summary": "Country (GeoID) for new users: affects the Store, weather and content offers; does not change the display language or the time zone.",
      "effect": "Default is Ukraine (241, UA).",
      "versions": "Windows 10 1803+ reads the Name value first.",
      "params": {
        "geo_id": {"type": "string", "title": "Country GeoID", "default": "241"},
        "geo_name": {"type": "string", "title": "Two-letter country code", "default": "UA"}
      },
      "actions": [
        {
          "type": "reg",
          "path": "DU:\\Control Panel\\International\\Geo",
          "name": "Nation",
          "kind": "String",
          "value": "{geo_id}",
          "default": "unknown"
        },
        {
          "type": "reg",
          "path": "DU:\\Control Panel\\International\\Geo",
          "name": "Name",
          "kind": "String",
          "value": "{geo_name}",
          "default": "unknown"
        }
      ]
    },
    {
      "id": "default-user.http-accept-language-optout",
      "group": "privacy.ads",
      "phase": "default-user",
      "title": "Do not share the user's language list with websites",
      "level": "optional",
      "default": true,
      "tags": ["accept-language", "fingerprinting", "browser", "privacy"],
      "doc": "docs/technical/reference/14-default-user-profile.md#unconditional-values",
      "summary": "Browsers do not send the list of preferred languages to websites (reduces the fingerprint).",
      "effect": "Websites determine the language by other means.",
      "versions": "Windows 10+.",
      "actions": [
        {
          "type": "reg",
          "path": "DU:\\Control Panel\\International\\User Profile",
          "name": "HttpAcceptLanguageOptOut",
          "kind": "DWord",
          "value": 1,
          "default": "absent"
        }
      ]
    },
    {
      "id": "default-user.input-switch-keys",
      "group": "default-user",
      "phase": "default-user",
      "title": "Keys that switch the input language and the keyboard layout",
      "level": "optional",
      "default": false,
      "tags": [
        "keyboard layout",
        "input language",
        "hotkey",
        "hot keys",
        "key sequence",
        "alt+shift",
        "ctrl+shift",
        "language hotkey",
        "layout hotkey",
        "toggle",
        "sign-in screen"
      ],
      "doc": "docs/technical/reference/14-default-user-profile.md#keys-that-switch-the-input-language",
      "summary": "The key sequences that switch the input languages (for example ENG, UKR, RUS) and the keyboard layouts of one language, for the sign-in screen and every account created after installation. Win+Space always works and cannot be changed.",
      "effect": "No answer file setting exists for these keys, so the rule writes them to the registry. Without the rule Windows keeps its own keys (Left Alt+Shift for languages, Ctrl+Shift for layouts). The user can still change them in Settings; accounts that already exist are not changed.",
      "risk": "\"Not assigned\" for languages leaves only Win+Space and the language indicator of the taskbar, which people who do not know them may not find. Ctrl+Shift for languages may switch by accident in programs that use Ctrl+Shift shortcuts.",
      "versions": "Windows 10 and 11, all editions: the values Hotkey, Language Hotkey and Layout Hotkey (REG_SZ) of Keyboard Layout\\Toggle. The numbers 1, 2 and 3 are documented with SPI_SETLANGTOGGLE; which value switches languages and which layouts is reported by third parties. The keys of the sign-in screen live in HKU\\.DEFAULT, the profile of the system account. Check in a virtual machine that Setup and the first sign-in keep the values.",
      "verify": "Under an account created after installation: reg query \"HKCU\\Keyboard Layout\\Toggle\" shows the chosen values, and Settings, Time & language, Typing, Advanced keyboard settings, Input language hot keys shows the same keys. Sign-in screen: reg query \"HKU\\.DEFAULT\\Keyboard Layout\\Toggle\".",
      "rollback": "For one user: Settings, Time & language, Typing, Advanced keyboard settings, Input language hot keys, Change Key Sequence. For future accounts and the sign-in screen: delete the values Hotkey, Language Hotkey and Layout Hotkey in Keyboard Layout\\Toggle of the default profile and of HKU\\.DEFAULT.",
      "params": {
        "language": {
          "type": "enum",
          "title": "Switch the input language",
          "default": "1",
          "values": [
            {"value": "1", "title": "Left Alt+Shift (Windows default)"},
            {"value": "2", "title": "Ctrl+Shift"},
            {"value": "3", "title": "Not assigned (Win+Space and the taskbar only)"}
          ]
        },
        "layout": {
          "type": "enum",
          "title": "Switch the keyboard layout of one language",
          "default": "2",
          "values": [
            {"value": "2", "title": "Ctrl+Shift (Windows default)"},
            {"value": "1", "title": "Left Alt+Shift"},
            {"value": "3", "title": "Not assigned"}
          ],
          "differs_from": "language",
          "same_allowed": ["3"]
        }
      },
      "actions": [
        {
          "type": "reg",
          "path": "DU:\\Keyboard Layout\\Toggle",
          "name": "Language Hotkey",
          "kind": "String",
          "value": "{language}",
          "why": "input language switch keys of new accounts",
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Keyboard Layout\\Toggle",
          "name": "Hotkey",
          "kind": "String",
          "value": "{language}",
          "why": "older copy of Language Hotkey",
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "DU:\\Keyboard Layout\\Toggle",
          "name": "Layout Hotkey",
          "kind": "String",
          "value": "{layout}",
          "why": "keyboard layout switch keys of new accounts",
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "HKU:\\.DEFAULT\\Keyboard Layout\\Toggle",
          "name": "Language Hotkey",
          "kind": "String",
          "value": "{language}",
          "why": "input language switch keys of the sign-in screen",
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "HKU:\\.DEFAULT\\Keyboard Layout\\Toggle",
          "name": "Hotkey",
          "kind": "String",
          "value": "{language}",
          "why": "older copy of Language Hotkey, sign-in screen",
          "default": "absent"
        },
        {
          "type": "reg",
          "path": "HKU:\\.DEFAULT\\Keyboard Layout\\Toggle",
          "name": "Layout Hotkey",
          "kind": "String",
          "value": "{layout}",
          "why": "keyboard layout switch keys of the sign-in screen",
          "default": "absent"
        }
      ]
    }
  ]
}
